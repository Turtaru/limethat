{
  "name": "limethat",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "icons:generate": "node scripts/generate-icons.mjs",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "build": "npm run check && vite build",
    "build:framing": "npm run check && vite build --mode framing --outDir dist-framing",
    "preview": "vite preview --host 0.0.0.0",
    "test": "tsx --test checks/*.test.ts"
  },
  "dependencies": {
    "dompurify": "^3.5.0",
    "lossless-json": "^4.3.3",
    "marked": "^18.3.0",
    "svelte": "^5.57.3",
    "svelte-spa-router": "^5.1.1"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^24.0.0",
    "@types/wicg-file-system-access": "^2023.10.7",
    "emoji-picker-element-data": "^1.8.0",
    "sharp": "^0.35.5",
    "svelte-check": "^4.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.6"
  }
}
